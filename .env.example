# Nexova — environment variables. Copy to .env.local for local work.
# Production/Preview values live in the Vercel project settings, never in git.

# Public origin used for canonical URLs, hreflang, sitemap and OG.
NEXT_PUBLIC_SITE_URL=https://nexova-nu.vercel.app

# --- Lead notification email (Resend) ---
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. "Nexova <contact@your-domain.ch>"
CONTACT_FROM_EMAIL=
# Inbox that receives enquiries
CONTACT_EMAIL=nexova.website@gmail.com

# --- Lead storage + persistent rate limiting (Upstash Redis) ---
# Injected automatically by the Vercel Marketplace Upstash integration
# (as KV_REST_API_URL / KV_REST_API_TOKEN) — either naming works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random string used to salt the hashed IPs kept for rate limiting
RATE_LIMIT_SALT=

# --- Legacy fallback (used only if RESEND_API_KEY is not set) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
